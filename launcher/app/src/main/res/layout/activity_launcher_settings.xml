<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings in three panes (SettingsScreen): categories, the chosen category's rows, and what the focused
     row does. Built in code from SettingsCatalog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:orientation="horizontal"
    android:paddingStart="40dp"
    android:paddingTop="28dp"
    android:paddingEnd="40dp"
    android:paddingBottom="20dp">

    <ScrollView
        android:id="@+id/railScroll"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:background="@drawable/settings_info_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/infoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFB8E0C8"
            android:textSize="15sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <TextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="#FFDDE3E8"
                android:textSize="14sp" />
        </ScrollView>

        <TextView
            android:id="@+id/infoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF8A96A0"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
