<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The update job survives a restart of the TV. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only apps signed with the same key (the launcher built from this repo) may read the pictures. -->
    <permission android:name="local.tvhome.wallfetch.READ_WALLS" android:protectionLevel="signature" />

    <application android:allowBackup="false" android:fullBackupContent="false" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:label="@string/app_name" android:icon="@drawable/icon" android:banner="@drawable/banner">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
        <service android:name=".FetchJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <provider android:name=".WallsProvider" android:authorities="local.tvhome.wallfetch.walls"
            android:exported="true" android:readPermission="local.tvhome.wallfetch.READ_WALLS" />
    </application>
</manifest>
